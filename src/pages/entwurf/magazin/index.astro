---
// Entwurf 3 „Magazin“: Nachrichtenportal. Laufband und Hauptmenü sitzen in der Kopfzeile (HeaderMagazin),
// hier folgen die flache Claim-Zeile, direkt darunter das Artikelraster, dann Kacheln aus der Community,
// Empfehlungen, Podcast, Ökosystem und Meetups.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArtikelKarte from '../../../components/ArtikelKarte.astro';
import MeetupTeaser from '../../../components/MeetupTeaser.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import RefCard from '../../../components/RefCard.astro';
import WerbeHinweis from '../../../components/WerbeHinweis.astro';
import { getArtikel } from '../../../lib/artikel';
import { getEpisoden } from '../../../lib/podcast';
import { getMeetupStatistik } from '../../../lib/portal';
import { datumKurz, isoDatum, terminKurz } from '../../../lib/format';
import { EXTERN, SITE } from '../../../lib/site';

const artikel = await getArtikel();
// Der neueste Artikel liegt quer über zwei Spalten, danach bis zu sechs weitere.
const raster = artikel.slice(0, 7);

const folgen = (await getEpisoden()).slice(0, 3);
const meetups = await getMeetupStatistik();
const naechstes = meetups.kommende[0];

const projekte = (await getCollection('projects'))
  .filter((p) => p.data.karte !== undefined)
  .sort((a, b) => (a.data.karte ?? 0) - (b.data.karte ?? 0))
  .slice(0, 6);

const alleEmpfehlungen = (await getCollection('empfehlungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const gesehen = new Set<string>();
const teaser = alleEmpfehlungen
  .filter((e) => {
    if (gesehen.has(e.data.kategorie)) return false;
    gesehen.add(e.data.kategorie);
    return true;
  })
  .slice(0, 3);
const aktiveWerbelinks = alleEmpfehlungen.filter((e) => e.data.werbelink).length;

// Drei Kacheln unter dem Aufmacher: was die Community gerade bewegt.
const kacheln = [
  {
    label: 'Podcast',
    text: folgen[0]?.titel ?? 'Alle Folgen des Einundzwanzig-Podcasts',
    href: folgen[0]?.url ?? EXTERN.podcastFolgen,
    aktion: 'Anhören',
  },
  {
    label: 'Meetups',
    text: naechstes
      ? `${terminKurz(naechstes.start)}: ${naechstes.meetup.name}`
      : `${meetups.gesamt} Meetups in ${meetups.laender} Ländern`,
    href: naechstes?.termin.portalLink ?? EXTERN.portalKarte,
    aktion: 'Zum Portal',
  },
  {
    label: 'Verein',
    text: 'Infrastruktur für Mitglieder: Relay, Nostr-Adresse, Watchtower, Speicher.',
    href: EXTERN.verein,
    aktion: 'Mitglied werden',
  },
];
---

<Base
  entwurf="magazin"
  title="Magazin"
  description="Bitcoin-News, Wissen und Community: Artikel, Podcast, Meetups, Projekte und Empfehlungen der Einundzwanzig-Community."
>
  <section class="wrap pt-7 pb-6" aria-labelledby="claim-titel">
    <h1 id="claim-titel" class="font-display text-[clamp(1.35rem,4vw,1.9rem)] leading-tight font-extrabold tracking-tight">
      {SITE.claim}
    </h1>
  </section>

  <section class="wrap" aria-labelledby="news-titel">
    <h2 id="news-titel" class="border-b border-line pb-3 font-display text-2xl font-bold sm:text-3xl">Aktuelle News</h2>
    {
      raster.length === 0 ? (
        <p class="mt-6 text-ink-2">Die ersten Ausgaben folgen.</p>
      ) : (
        <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {raster.map((a, i) => (
            <ArtikelKarte artikel={a} quer={i === 0} class={i === 0 ? 'sm:col-span-2' : ''} />
          ))}
        </div>
      )
    }
    <div class="mt-10 text-center">
      <a class="btn btn-ghost" href="/artikel/">Alle Artikel anzeigen</a>
    </div>
  </section>

  <section class="wrap pt-12" aria-label="Aus der Community">
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        kacheln.map((k) => (
          <li class="flex flex-col gap-2 rounded-2xl border border-line p-5">
            <span class="text-sm font-semibold text-orange-ink">{k.label}</span>
            <p class="line-clamp-2 font-display font-semibold leading-snug">{k.text}</p>
            <a class="link mt-auto text-sm" href={k.href} rel="noopener">
              {k.aktion}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap pt-14" aria-labelledby="empfehlungen-titel">
    <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-line pb-3">
      <h2 id="empfehlungen-titel" class="font-display text-2xl font-bold sm:text-3xl">Empfehlungen</h2>
      <a class="link text-sm" href="/empfehlungen">Alle Empfehlungen</a>
    </div>
    <div class="mt-6">
      <WerbeHinweis aktiveWerbelinks={aktiveWerbelinks} />
    </div>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {teaser.map((e) => <RefCard eintrag={e} />)}
    </div>
  </section>

  <section class="wrap pt-14" aria-labelledby="podcast-titel">
    <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-line pb-3">
      <h2 id="podcast-titel" class="font-display text-2xl font-bold sm:text-3xl">Neue Folgen</h2>
      <a class="link text-sm" href={EXTERN.podcastFolgen} rel="noopener">Alle Folgen</a>
    </div>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        folgen.map((f) => (
          <li class="flex flex-col gap-2 rounded-2xl border border-line p-5">
            <div class="flex flex-wrap items-baseline gap-x-3 text-sm">
              <span class="font-semibold text-orange-ink">{f.format}</span>
              <time datetime={isoDatum(f.datum)} class="font-mono text-ink-3">
                {datumKurz(f.datum)}
              </time>
            </div>
            <a href={f.url} rel="noopener" class="font-display text-lg leading-snug font-semibold no-underline hover:text-orange-ink">
              {f.titel}
            </a>
            {f.dauer && <span class="mt-auto font-mono text-sm text-ink-3">{f.dauer}</span>}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap pt-14" aria-labelledby="projekte-titel">
    <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-line pb-3">
      <h2 id="projekte-titel" class="font-display text-2xl font-bold sm:text-3xl">Ökosystem</h2>
      <a class="link text-sm" href="/projekte">Alle Projekte</a>
    </div>
    <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {projekte.map((p) => <ProjectCard projekt={p} />)}
    </div>
  </section>

  <MeetupTeaser />

  <section class="wrap" aria-labelledby="ueber-titel">
    <div class="grid gap-6 rounded-2xl border border-line bg-bg-2 p-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-center lg:p-8">
      <div>
        <h2 id="ueber-titel" class="font-display text-2xl font-bold sm:text-3xl">Über Einundzwanzig</h2>
        <p class="mt-3 text-ink-2">
          Aus einem Podcast sind Hunderte Stammtische, ein Verein und eine Reihe von Apps geworden. Diese Seite sammelt, was
          dazugehört, und zeigt, was neu ist. Von der Community, für die Community.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a class="btn btn-primary" href="/start">Ich bin neu hier</a>
        <a class="btn btn-ghost" href="/unterstuetzen">Unterstützen</a>
      </div>
    </div>
  </section>
</Base>
