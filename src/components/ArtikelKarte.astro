---
import ArtikelBild from './ArtikelBild.astro';
import { RUBRIK_LABEL, type Beitrag } from '../lib/artikel';
import { datumKurz, isoDatum } from '../lib/format';

interface Props {
  beitrag: Beitrag;
  // quer: Bild links, Text rechts. Für den neuesten Beitrag oben im Raster, dort über zwei Spalten.
  quer?: boolean;
  // h2, wenn die Karten direkt unter der Seitenüberschrift stehen (Übersicht), sonst h3.
  ueberschrift?: 'h2' | 'h3';
  class?: string;
}
const { beitrag, quer = false, ueberschrift: Ueberschrift = 'h3', class: klasse = '' } = Astro.props;
const { titel, teaser, datum, rubrik, beispiel, href, extern, autor } = beitrag;
const rel = extern ? 'noopener' : undefined;
---

<article class={`${quer ? 'grid gap-4 self-start sm:grid-cols-2 sm:items-center sm:gap-6' : 'flex flex-col gap-3'} ${klasse}`}>
  <a href={href} rel={rel} class="no-underline" tabindex="-1" aria-hidden="true">
    <ArtikelBild
      beitrag={beitrag}
      widths={quer ? [640, 960] : undefined}
      sizes={quer ? '(min-width: 1024px) 40vw, 100vw' : undefined}
      prioritaet={quer}
    />
  </a>
  <div class="flex flex-col gap-3">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
      <a href={`/artikel/rubrik/${rubrik}/`} class="font-semibold text-orange-ink no-underline hover:underline">{RUBRIK_LABEL[rubrik]}</a>
      <time datetime={isoDatum(datum)} class="font-mono text-ink-3">{datumKurz(datum)}</time>
      {extern && <span class="text-ink-3">{autor}</span>}
      {beispiel && <span class="rounded-full border border-beta/70 px-2 py-0.5 text-xs text-beta">Beispiel</span>}
    </div>
    <Ueberschrift class={`font-display leading-snug font-bold ${quer ? 'text-2xl' : 'text-xl'}`}>
      <a href={href} rel={rel} class="no-underline hover:text-orange-ink">{titel}</a>
    </Ueberschrift>
    {teaser && <p class="line-clamp-3 text-ink-2">{teaser}</p>}
  </div>
</article>
