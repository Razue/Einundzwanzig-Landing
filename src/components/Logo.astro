---
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="30" fill="var(--orange)"></circle>
  <circle cx="32" cy="32" r="23" fill="none" stroke="#1e1712" stroke-opacity=".35" stroke-width="1.5" stroke-dasharray="2 5"></circle>
  <text x="32" y="41" text-anchor="middle" font-family="Syne Variable, Avenir Next, Segoe UI, sans-serif" font-weight="800" font-size="26" fill="#1e1712">21</text>
</svg>
