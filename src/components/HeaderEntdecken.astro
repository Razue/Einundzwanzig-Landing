---
// Kopfzeile für Entwurf „Entdecken“: Wortmarke mit orangem Punkt, Navigation als Pillen, rechts
// Theme-Schalter und ein dunkler Knopf. Keine Trennlinie, die Hero-Karte beginnt direkt darunter.
import { EXTERN } from '../lib/site';
import { HOMES } from '../lib/entwuerfe';
import ThemeToggle from './ThemeToggle.astro';

const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';
const home = HOMES.entdecken.replace(/\/$/, '');

function istAktiv(href: string): boolean {
  const p = href.replace(/\/$/, '');
  if (!p.startsWith('/')) return false;
  if (p === home) return pfad === home;
  return pfad === p || pfad.startsWith(p + '/');
}

const nav = [
  { href: HOMES.entdecken, label: 'Entdecken' },
  { href: '/artikel', label: 'Artikel' },
  { href: '/projekte', label: 'Projekte' },
  { href: '/empfehlungen', label: 'Empfehlungen' },
  { href: EXTERN.portalKarte, label: 'Meetups', extern: true },
];
---

<header class="nur-entdecken">
  <div class="wrap flex flex-wrap items-center gap-x-3 gap-y-3 py-4">
    <a href={HOMES.entdecken} class="mr-3 text-[1.4rem] leading-none font-extrabold tracking-tight text-ink no-underline">
      Einundzwanzig<span class="text-orange">.</span>
    </a>
    <nav
      aria-label="Hauptnavigation"
      class="order-last -mx-1 flex w-[calc(100%+0.5rem)] gap-1 overflow-x-auto px-1 [scrollbar-width:none] md:order-none md:mx-0 md:w-auto md:px-0"
    >
      {
        nav.map((n) => (
          <a
            href={n.href}
            rel={n.extern ? 'noopener' : undefined}
            aria-current={istAktiv(n.href) ? 'page' : undefined}
            class="shrink-0 rounded-full border border-transparent px-3.5 py-1.5 text-sm font-medium text-ink-2 no-underline hover:text-ink aria-[current=page]:border-line aria-[current=page]:bg-bg-2 aria-[current=page]:text-ink aria-[current=page]:shadow-sm"
          >
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <a href={EXTERN.verein} rel="noopener" class="rounded-full bg-ink px-4 py-2 text-sm font-semibold text-bg no-underline hover:opacity-90">Verein</a>
    </div>
  </div>
</header>
