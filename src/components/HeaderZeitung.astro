---
// Kopfzeile für Entwurf „Zeitung“: schmale Kopfleiste mit Datum, Navigation und Theme-Schalter, darunter
// der Zeitungskopf mit der Wortmarke zwischen kräftigen Linien. Die Startseite zeigt die große Wortmarke
// mit Laufband, Unterseiten einen niedrigen Kopf, damit der Text schnell beginnt.
import { EXTERN } from '../lib/site';
import { HOMES } from '../lib/entwuerfe';
import { datumLang, isoDatum } from '../lib/format';
import ThemeToggle from './ThemeToggle.astro';
import Laufband from './Laufband.astro';

// Pfade ohne Schluss-Schrägstrich vergleichen; die Startseite „/“ bleibt „/“.
const norm = (s: string) => s.replace(/\/$/, '') || '/';
const pfad = norm(Astro.url.pathname);
const home = norm(HOMES.zeitung);
const istStart = pfad === home;
const jetzt = new Date();

function istAktiv(href: string): boolean {
  if (href.includes('#')) return false;
  const p = norm(href);
  if (!p.startsWith('/')) return false;
  if (p === home) return istStart;
  return pfad === p || pfad.startsWith(p + '/');
}

const nav = [
  { href: HOMES.zeitung, label: 'Aktuell' },
  { href: '/artikel/', label: 'Artikel' },
  { href: `${HOMES.zeitung}#tippspiele`, label: 'Tippspiele' },
  { href: '/projekte/', label: 'Projekte' },
  { href: '/empfehlungen/', label: 'Empfehlungen' },
  { href: EXTERN.portalKarte, label: 'Meetups', extern: true },
  { href: '/start/', label: 'Neu hier' },
];
---

<header class="nur-zeitung">
  <div class="wrap">
    <div class="etikett flex flex-wrap items-center gap-x-5 gap-y-1 pt-2.5 pb-2 font-medium text-ink-2">
      <time datetime={isoDatum(jetzt)} class="mr-auto">{datumLang(jetzt)}</time>
      {/* Innenabstand rundum, damit der Fokusring im Scroll-Bereich nicht abgeschnitten wird. */}
      <nav
        aria-label="Hauptnavigation"
        class="order-last -m-1.5 flex w-[calc(100%+0.75rem)] gap-5 overflow-x-auto p-1.5 [scrollbar-width:none] min-[68rem]:order-none min-[68rem]:w-auto"
      >
        {
          nav.map((n) => (
            <a
              href={n.href}
              rel={n.extern ? 'noopener' : undefined}
              aria-current={istAktiv(n.href) ? 'page' : undefined}
              class="shrink-0 py-1 text-ink-2 no-underline hover:text-orange-ink aria-[current=page]:font-bold aria-[current=page]:text-ink"
            >
              {n.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>

    <div class={`zeitungskopf text-center ${istStart ? 'pt-3' : 'py-3'}`}>
      <a
        href={HOMES.zeitung}
        class={`block font-display leading-[0.95] font-bold tracking-[0.03em] text-ink uppercase no-underline ${istStart ? 'text-[clamp(1.5rem,8.2vw,5.4rem)]' : 'text-[clamp(1.35rem,5vw,2.25rem)]'}`}
      >
        Einundzwanzig
      </a>
      {istStart && <Laufband class="mt-4 mb-[7px] border-t border-line bg-bg font-sans text-xs tracking-wider uppercase" />}
    </div>
  </div>
</header>

<style>
  /* Kräftige Linie oben, Doppellinie unten, wie ein Zeitungskopf. */
  .zeitungskopf {
    position: relative;
    border-top: 3px solid var(--linie-stark);
    border-bottom: 1px solid var(--linie-stark);
  }
  .zeitungskopf::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 3px;
    left: 0;
    border-bottom: 1px solid var(--linie-stark);
  }
</style>
