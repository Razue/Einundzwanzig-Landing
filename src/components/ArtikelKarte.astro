---
import ArtikelBild from './ArtikelBild.astro';
import { artikelPfad, RUBRIK_LABEL, type Artikel } from '../lib/artikel';
import { datumKurz, isoDatum } from '../lib/format';

interface Props {
  artikel: Artikel;
}
const { artikel } = Astro.props;
const { titel, teaser, datum, rubrik, beispiel } = artikel.data;
const pfad = artikelPfad(artikel);
---

<article class="flex flex-col gap-3">
  <a href={pfad} class="no-underline" tabindex="-1" aria-hidden="true"><ArtikelBild artikel={artikel} /></a>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
    <span class="font-semibold text-orange-ink">{RUBRIK_LABEL[rubrik]}</span>
    <time datetime={isoDatum(datum)} class="font-mono text-ink-3">{datumKurz(datum)}</time>
    {beispiel && <span class="rounded-full border border-beta/70 px-2 py-0.5 text-xs text-beta">Beispiel</span>}
  </div>
  <h3 class="font-display text-xl leading-snug font-bold">
    <a href={pfad} class="no-underline hover:text-orange-ink">{titel}</a>
  </h3>
  <p class="line-clamp-3 text-ink-2">{teaser}</p>
</article>
