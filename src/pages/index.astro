---
// Startseite, Entwurf 5 „Zeitung“: links der Aufmacher und das Artikelraster, rechts eine Spalte mit
// Kästen (Tippspiele, Podcast, Meetups, Empfehlungen, Ökosystem). Auf schmalen Bildschirmen stehen die
// Tippspiel-Kästen direkt unter dem Aufmacher, die übrigen nach den Artikeln. Alles kommt aus dem Build.
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArtikelBild from '../components/ArtikelBild.astro';
import Kasten from '../components/Kasten.astro';
import KycBadge from '../components/KycBadge.astro';
import { getBeitraege, RUBRIK_LABEL } from '../lib/artikel';
import { getLaufband } from '../lib/bitcoin';
import { getEpisoden } from '../lib/podcast';
import { getMeetupStatistik } from '../lib/portal';
import { datumKurz, datumTag, isoDatum, uhrzeit } from '../lib/format';
import { EXTERN } from '../lib/site';
import podcastCover from '../assets/podcast-cover.jpg';

// Eigene Artikel und die täglichen Nachrichten zusammen, der neueste Beitrag ist der Aufmacher.
const beitraege = await getBeitraege();
const aufmacher = beitraege[0];
const weitere = beitraege.slice(1, 14);

const { felder, stand } = await getLaufband();
const kurs = felder.find((f) => f.id === 'usd')?.wert;

const kickstr = await getEntry('projects', 'kickstr');
const folge = (await getEpisoden())[0];
const meetups = await getMeetupStatistik();
const termine = meetups.kommende.slice(0, 3);

const projekte = (await getCollection('projects'))
  .filter((p) => p.data.karte !== undefined)
  .sort((a, b) => (a.data.karte ?? 0) - (b.data.karte ?? 0));

// Je Kategorie die erste Empfehlung, höchstens drei.
const alleEmpfehlungen = (await getCollection('empfehlungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const gesehen = new Set<string>();
const empfehlungen = alleEmpfehlungen
  .filter((e) => {
    if (gesehen.has(e.data.kategorie)) return false;
    gesehen.add(e.data.kategorie);
    return true;
  })
  .slice(0, 3);

const minuten = (dauer?: string) => {
  if (!dauer) return null;
  const t = dauer.split(':').map(Number);
  if (t.some(Number.isNaN)) return null;
  const sekunden = t.length === 3 ? t[0] * 3600 + t[1] * 60 + t[2] : t.length === 2 ? t[0] * 60 + t[1] : t[0];
  return Math.round(sekunden / 60);
};
const tz = 'Europe/Berlin';
const tag = (d: Date) => new Intl.DateTimeFormat('de-DE', { day: '2-digit', timeZone: tz }).format(d);
const monatKurz = (d: Date) => new Intl.DateTimeFormat('de-DE', { month: 'short', timeZone: tz }).format(d).replace('.', '');
const rel = (extern: boolean) => (extern ? 'noopener' : undefined);
---

<Base
  entwurf="zeitung"
  description="Was die Einundzwanzig-Community bewegt: Bitcoin Daily, Artikel, Tippspiele, Podcast, Meetups, Projekte und Empfehlungen."
>
  <div class="wrap flex flex-col gap-y-7 pb-4 lg:grid lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start lg:gap-x-11 lg:gap-y-0">
    <div class="contents lg:block">
      {
        aufmacher && (
          <section class="order-1 grid items-center gap-5 pt-7 md:grid-cols-[1.15fr_0.85fr] md:gap-7" aria-labelledby="aufmacher-titel">
            <div>
              <p class="etikett flex flex-wrap items-center gap-2 text-orange-ink">
                {RUBRIK_LABEL[aufmacher.rubrik]} · Aufmacher
                {aufmacher.beispiel && <span class="rounded-full border border-beta/70 px-1.5 py-px tracking-normal text-beta normal-case">Beispiel</span>}
              </p>
              <h1 id="aufmacher-titel" class="mt-3 text-[clamp(1.75rem,2.9vw,2.6rem)] leading-[1.08] font-bold tracking-tight">
                <a href={aufmacher.href} rel={rel(aufmacher.extern)} class="no-underline hover:text-orange-ink">
                  {aufmacher.titel}
                </a>
              </h1>
              {aufmacher.teaser && <p class="mt-4 line-clamp-4 max-w-[36em] text-[1.05rem] leading-snug text-ink-2">{aufmacher.teaser}</p>}
              <p class="mt-4 font-sans text-sm text-ink-3">
                Von <strong class="font-semibold text-ink">{aufmacher.autor}</strong> ·{' '}
                <time datetime={isoDatum(aufmacher.datum)}>{datumTag(aufmacher.datum)}</time>
              </p>
              <a href={aufmacher.href} rel={rel(aufmacher.extern)} class="etikett mt-5 inline-block border-b-2 border-linie-stark pb-0.5 text-ink no-underline hover:border-orange-ink hover:text-orange-ink">
                Artikel lesen
              </a>
            </div>
            <a href={aufmacher.href} rel={rel(aufmacher.extern)} class="block no-underline" tabindex="-1" aria-hidden="true">
              <ArtikelBild beitrag={aufmacher} widths={[480, 800]} sizes="(min-width: 768px) 400px, 100vw" prioritaet />
            </a>
          </section>
        )
      }

      <section class="order-3 lg:mt-9" aria-labelledby="weitere-titel">
        <div class="mb-5 flex items-baseline justify-between gap-4 border-b-2 border-ink pb-2">
          <h2 id="weitere-titel" class="text-[1.3rem] font-bold">Weitere Artikel</h2>
          <a href="/artikel/" class="etikett font-medium text-ink-2 no-underline hover:text-orange-ink">Alle Artikel</a>
        </div>
        <div class="grid gap-x-7 gap-y-6 sm:grid-cols-2">
          {
            weitere.map((b, i) => (
              <article class={`border-b border-line pb-5 ${i === 0 ? 'sm:col-span-2 sm:grid sm:grid-cols-[180px_1fr] sm:items-start sm:gap-5' : ''}`}>
                {i === 0 && (
                  <a href={b.href} rel={rel(b.extern)} class="hidden no-underline sm:block" tabindex="-1" aria-hidden="true">
                    <ArtikelBild beitrag={b} widths={[240, 480]} sizes="180px" />
                  </a>
                )}
                <div>
                  <p class="etikett flex flex-wrap items-center gap-2 text-orange-ink">
                    {RUBRIK_LABEL[b.rubrik]}
                    {b.beispiel && <span class="rounded-full border border-beta/70 px-1.5 py-px tracking-normal text-beta normal-case">Beispiel</span>}
                  </p>
                  <h3 class="mt-2 text-[1.25rem] leading-[1.18] font-bold">
                    <a href={b.href} rel={rel(b.extern)} class="no-underline hover:text-orange-ink">
                      {b.titel}
                    </a>
                  </h3>
                  {b.teaser && <p class="mt-2 line-clamp-3 text-[0.95rem] leading-snug text-ink-2">{b.teaser}</p>}
                  <p class="mt-2.5 font-sans text-xs text-ink-3">
                    {b.autor} · <time datetime={isoDatum(b.datum)}>{datumKurz(b.datum)}</time>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/artikel/" class="btn btn-primary">Alle Artikel</a>
          <a href="/start/" class="btn btn-ghost">Ich bin neu hier</a>
        </div>
      </section>
    </div>

    <aside class="contents lg:flex lg:flex-col lg:gap-4 lg:pt-7" aria-label="Tippspiele und Community">
      <div id="tippspiele" class="order-2 flex scroll-mt-6 flex-col gap-4">
        <Kasten id="btc-tipp" titel="Bitcoin-Preis tippen">
          {
            kurs && (
              <>
                <p class="font-sans text-xs tracking-wide text-ink-3 uppercase">Kurs von {uhrzeit(stand)} Uhr</p>
                <p class="font-mono text-[1.6rem] leading-tight font-medium tracking-tight">{kurs}</p>
              </>
            )
          }
          <p class="mt-3 font-display text-[1.1rem] leading-snug font-bold">Wo steht Bitcoin am 31. Dezember 2026?</p>
          <p class="mt-2 text-sm leading-snug text-ink-2">Ein Tipp in Dollar, signiert mit deinem Nostr-Schlüssel. Wer dem Schlusskurs am nächsten kommt, steht oben.</p>
          <p class="mt-3 flex items-center gap-2 font-sans text-xs text-ink-2">
            <span class="status-dot beta" aria-hidden="true"></span>
            Der Jahresend-Tipp startet in Kürze.
          </p>
        </Kasten>

        {
          kickstr?.data.links.web && (
            <Kasten id="fussball-tipp" titel="Fußball-Tippspiele" href={`/projekte/${kickstr.id}/`} mehr="Über Kickstr">
              <p class="font-display text-[1.1rem] leading-snug font-bold">Bundesliga und Champions League tippen</p>
              <p class="mt-2 text-sm leading-snug text-ink-2">
                Getippt wird auf Kickstr mit deinem Nostr-Konto. Jeder Tipp ist ein signiertes Event, die Rangliste kann jeder nachrechnen.
              </p>
              <a href={kickstr.data.links.web} rel="noopener" class="btn btn-primary mt-4 w-full">Auf Kickstr tippen</a>
            </Kasten>
          )
        }
      </div>

      <div class="order-4 flex flex-col gap-4">
        {
          folge && (
            <Kasten id="podcast" titel="Podcast" href={EXTERN.podcastFolgen} mehr="Alle Folgen" extern>
              <div class="grid grid-cols-[112px_1fr] items-start gap-x-4 lg:grid-cols-1">
                <a href={folge.url} rel="noopener" class="block no-underline lg:mb-3" tabindex="-1" aria-hidden="true">
                  <Image src={podcastCover} alt="" widths={[224, 616]} sizes="(min-width: 1024px) 306px, 112px" class="aspect-square w-full border border-line object-cover" />
                </a>
                <div>
                  <p class="etikett text-orange-ink">Neueste Folge</p>
                  <h3 class="mt-1 font-editorial text-base leading-snug font-semibold">
                    <a href={folge.url} rel="noopener" class="no-underline hover:text-orange-ink">
                      {folge.titel}
                    </a>
                  </h3>
                  <p class="mt-1 font-sans text-xs text-ink-3">
                    <time datetime={isoDatum(folge.datum)}>{datumKurz(folge.datum)}</time>
                    {minuten(folge.dauer) ? ` · ${minuten(folge.dauer)} Min.` : ''}
                  </p>
                </div>
              </div>
            </Kasten>
          )
        }

        {
          termine.length > 0 && (
            <Kasten id="meetups" titel="Meetups" href={EXTERN.portalKarte} mehr="Zur Karte" extern>
              <ul class="grid gap-3">
                {termine.map((k) => (
                  <li class="flex min-w-0 gap-3">
                    <div class="flex h-12 w-12 shrink-0 flex-col items-center justify-center border border-line font-sans" aria-hidden="true">
                      <span class="text-lg leading-none font-bold">{tag(k.start)}</span>
                      <span class="text-xs leading-tight text-ink-2">{monatKurz(k.start)}</span>
                    </div>
                    <div class="min-w-0">
                      <a href={k.termin.portalLink} rel="noopener" class="line-clamp-2 leading-snug font-semibold no-underline hover:text-orange-ink">
                        {k.meetup.name}
                      </a>
                      <p class="truncate font-sans text-xs text-ink-3">
                        {tag(k.start)}. {monatKurz(k.start)}, {uhrzeit(k.start)} Uhr{(k.termin.location || k.meetup.city) && ` · ${k.termin.location ?? k.meetup.city}`}
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
              <p class="mt-3 font-sans text-xs text-ink-3">
                {meetups.gesamt} Meetups in {meetups.laender} Ländern
              </p>
            </Kasten>
          )
        }

        <Kasten id="empfehlungen" titel="Empfehlungen" href="/empfehlungen/" mehr="Alle ansehen">
          <ul class="grid gap-3">
            {
              empfehlungen.map((e) => (
                <li>
                  <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
                    <a href={`/empfehlungen/${e.data.kategorie}/`} class="leading-snug font-semibold no-underline hover:text-orange-ink">
                      {e.data.anbieter}
                    </a>
                    <KycBadge kyc={e.data.kyc} />
                  </div>
                  <p class="mt-1 line-clamp-2 text-sm leading-snug text-ink-2">{e.data.vorteil}</p>
                </li>
              ))
            }
          </ul>
        </Kasten>

        <Kasten id="oekosystem" titel="Ökosystem" href="/projekte/" mehr="Alle Projekte">
          <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
            {
              projekte.map((p) => (
                <li class="min-w-0">
                  <a href={`/projekte/${p.id}/`} class="block truncate no-underline hover:text-orange-ink">
                    {p.data.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </Kasten>
      </div>
    </aside>
  </div>
</Base>
