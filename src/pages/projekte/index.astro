---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projekte = await getCollection('projects');
const gruppen = [
  { status: 'live', titel: 'Läuft', text: 'Kannst du heute benutzen.' },
  { status: 'beta', titel: 'Beta', text: 'Funktioniert, braucht Tester und Feedback.' },
  { status: 'idee', titel: 'Idee', text: 'Noch nicht gebaut. Wer mitmachen will, ist willkommen.' },
] as const;
const sortiert = (status: string) =>
  projekte
    .filter((p) => p.data.status === status)
    .sort((a, b) => (a.data.karte ?? 99) - (b.data.karte ?? 99) || a.data.name.localeCompare(b.data.name, 'de'));
---

<Base title="Projekte" description="Alle Projekte des Einundzwanzig-Ökosystems mit ehrlichem Status: was läuft, was in Beta ist und was noch Idee ist.">
  <section class="wrap pt-12 pb-6">
    <h1 class="h1 font-display">Projekte</h1>
    <p class="mt-5 max-w-[60ch] text-lg text-ink-2">
      Alles, was rund um Einundzwanzig gebaut wird, mit ehrlichem Status. Manches läuft seit Jahren, manches ist ein Prototyp
      vom letzten Hackathon.
    </p>
  </section>

  {
    gruppen.map((g) => {
      const liste = sortiert(g.status);
      if (liste.length === 0) return null;
      return (
        <section id={g.status} class="wrap scroll-mt-6 py-8" aria-labelledby={`titel-${g.status}`}>
          <div class="flex items-baseline gap-3">
            <span class:list={['status-dot', g.status]} aria-hidden="true" />
            <h2 id={`titel-${g.status}`} class="font-display text-2xl font-bold">
              {g.titel}
            </h2>
            <span class="text-sm text-ink-3">{g.text}</span>
          </div>
          <div class="mt-5 grid gap-5 md:grid-cols-2">
            {liste.map((p) => (
              <ProjectCard projekt={p} />
            ))}
          </div>
        </section>
      );
    })
  }
</Base>
