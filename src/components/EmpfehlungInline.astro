---
// Empfehlung mitten im Artikeltext. In MDX: <Empfehlung slug="bitbox02" />
// Die Kennzeichnung folgt denselben Regeln wie RefCard: Werbung nur bei werbelink: true.
import { getEntry } from 'astro:content';
import KycBadge from './KycBadge.astro';
import { datumKurz } from '../lib/format';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const eintrag = await getEntry('empfehlungen', slug);
if (!eintrag) throw new Error(`Empfehlung „${slug}“ gibt es nicht (src/content/empfehlungen)`);
const { anbieter, vorteil, url, werbelink, programm, kyc, code, geprueft_am } = eintrag.data;
const programmText = programm === 'offen' ? 'Partnerprogramm wird geprüft' : programm === 'kein' ? 'Kein Partnerprogramm' : 'Partnerlink';
---

<aside class="my-8 rounded-xl border border-line bg-bg-2 p-5" aria-label={`Empfehlung: ${anbieter}`}>
  <div class="flex flex-wrap items-center gap-2 text-xs text-ink-3">
    {
      werbelink ? (
        <span class="rounded-full border border-orange px-2 py-0.5 text-orange-ink">Werbung</span>
      ) : (
        <span>Empfehlung der Redaktion</span>
      )
    }
    <KycBadge kyc={kyc} />
  </div>
  <p class="mt-2 font-display text-lg font-bold my-0!">{anbieter}</p>
  <p class="text-ink-2 my-1!">{vorteil}</p>
  {
    code && (
      <p class="text-sm my-1!">
        Code <code class="rounded border border-line px-1.5 py-0.5 font-mono text-ink">{code}</code>
      </p>
    )
  }
  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
    <a class="btn btn-ghost text-sm" href={url} rel={werbelink ? 'sponsored noopener' : 'noopener'}>Zu {anbieter}</a>
    <span class="text-xs text-ink-3">
      {programmText}, Stand {datumKurz(geprueft_am)}. <a class="link" href="/werbehinweis">Wie wir auswählen</a>
    </span>
  </div>
</aside>
