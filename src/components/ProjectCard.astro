---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';

interface Props {
  projekt: CollectionEntry<'projects'>;
}
const { projekt } = Astro.props;
const { name, kurz, status, offiziell, links } = projekt.data;
const externeLinks = [
  links.web && { href: links.web, label: 'Website' },
  links.zapstore && { href: links.zapstore, label: 'Zapstore' },
  links.appstore && { href: links.appstore, label: 'App Store' },
  links.repo && { href: links.repo, label: 'Quellcode' },
].filter(Boolean) as { href: string; label: string }[];
---

<article class="flex flex-col gap-3 rounded-2xl border border-line bg-bg-2 p-5">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <h3 class="font-display text-xl font-bold">
      <a href={`/projekte/${projekt.id}`} class="no-underline hover:text-orange-ink">{name}</a>
    </h3>
    <StatusBadge status={status} />
    {offiziell && <span class="text-sm text-ink-3">vom Einundzwanzig-Team</span>}
  </div>
  <p class="text-ink-2">{kurz}</p>
  {
    externeLinks.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-1 text-sm">
        {externeLinks.map((l) => (
          <li>
            <a class="link" href={l.href} rel="noopener">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
