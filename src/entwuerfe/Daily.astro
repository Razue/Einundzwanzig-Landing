---
// Entwurf 2 „Daily“: oben nur die flache Claim-Zeile, direkt darunter die Nachrichten,
// das Ökosystem daneben und darunter.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SignalLeiste from '../components/SignalLeiste.astro';
import ArtikelKarte from '../components/ArtikelKarte.astro';
import FeedList from '../components/FeedList.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import MeetupTeaser from '../components/MeetupTeaser.astro';
import RefCard from '../components/RefCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import WerbeHinweis from '../components/WerbeHinweis.astro';
import { getBeitraege } from '../lib/artikel';
import { getFeed } from '../lib/feed';
import { EXTERN, SITE } from '../lib/site';

const beitraege = await getBeitraege();
const kurz = await getFeed(6);

const projekte = (await getCollection('projects'))
  .filter((p) => p.data.karte !== undefined)
  .sort((a, b) => (a.data.karte ?? 0) - (b.data.karte ?? 0));

const alleEmpfehlungen = (await getCollection('empfehlungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const gesehen = new Set<string>();
const teaser = alleEmpfehlungen
  .filter((e) => {
    if (gesehen.has(e.data.kategorie)) return false;
    gesehen.add(e.data.kategorie);
    return true;
  })
  .slice(0, 3);
const aktiveWerbelinks = alleEmpfehlungen.filter((e) => e.data.werbelink).length;
---

<Base
  entwurf="daily"
  title="Daily"
  description="Die täglichen Nachrichten der Einundzwanzig-Community, dazu Podcast, Meetups, Projekte und Empfehlungen auf einen Blick."
>
  <SignalLeiste />

  <section class="wrap pt-7 pb-6" aria-labelledby="claim-titel">
    <h1 id="claim-titel" class="font-display text-[clamp(1.35rem,4vw,1.9rem)] leading-tight font-extrabold tracking-tight">
      {SITE.claim}
    </h1>
  </section>

  <section class="wrap pb-14" aria-labelledby="news-titel">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)]">
      <div class="min-w-0">
        <h2 id="news-titel" class="border-b border-line pb-3 font-display text-2xl font-bold">Aktuelle News</h2>
        {
          beitraege.length === 0 ? (
            <p class="mt-6 text-ink-2">Die ersten Ausgaben folgen.</p>
          ) : (
            <div class="mt-6 grid gap-8 sm:grid-cols-2">
              {beitraege.map((b, i) => (
                <ArtikelKarte beitrag={b} quer={i === 0} class={i === 0 ? 'sm:col-span-2' : ''} />
              ))}
            </div>
          )
        }
      </div>
      <aside class="grid min-w-0 content-start gap-10">
        <div>
          <h2 class="border-b border-line pb-3 font-display text-2xl font-bold">Kurz notiert</h2>
          <div class="mt-2"><FeedList eintraege={kurz} /></div>
          <a class="link mt-3 inline-block text-sm" href={EXTERN.podcastFolgen} rel="noopener">Alle Podcast-Folgen</a>
        </div>
        <div>
          <h2 class="border-b border-line pb-3 font-display text-2xl font-bold">Ökosystem</h2>
          <ul class="mt-2 divide-y divide-line">
            {
              projekte.map((p) => (
                <li class="flex items-baseline justify-between gap-3 py-2.5">
                  <a href={`/projekte/${p.id}`} class="font-display font-semibold no-underline hover:text-orange-ink">
                    {p.data.name}
                  </a>
                  <StatusBadge status={p.data.status} />
                </li>
              ))
            }
          </ul>
          <a class="link mt-3 inline-block text-sm" href="/projekte">Alle Projekte</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y border-line bg-bg-2" aria-labelledby="karte-titel">
    <div class="wrap grid gap-8 py-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-12">
      <div class="min-w-0">
        <h2 id="karte-titel" class="font-display text-3xl font-bold sm:text-4xl">Alles an einem Tisch.</h2>
        <p class="mt-4 text-ink-2">
          Podcast, Meetups, Apps und Werkzeuge der Community, verbunden über Bitcoin und Nostr. Die Karte zeigt, was es gibt und
          was gerade entsteht.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/start">Ich bin neu hier</a>
          <a class="btn btn-ghost" href="/projekte">Alle Projekte</a>
        </div>
      </div>
      <div class="min-w-0"><EcosystemMap projekte={projekte} /></div>
    </div>
  </section>

  <div id="meetups"><MeetupTeaser /></div>

  <section class="wrap py-14" aria-labelledby="empfehlungen-titel">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="empfehlungen-titel" class="font-display text-3xl font-bold sm:text-4xl">Empfehlungen</h2>
      <a class="link text-sm" href="/empfehlungen">Alle Empfehlungen</a>
    </div>
    <div class="mt-6">
      <WerbeHinweis aktiveWerbelinks={aktiveWerbelinks} />
    </div>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {teaser.map((e) => <RefCard eintrag={e} />)}
    </div>
  </section>
</Base>
