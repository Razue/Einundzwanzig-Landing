---
import Base from '../layouts/Base.astro';
---

<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht.">
  <section class="wrap pt-16 pb-14">
    <h1 class="h1 font-display">Hier ist kein Tisch.</h1>
    <p class="mt-5 max-w-[50ch] text-lg text-ink-2">
      Die Adresse gibt es nicht oder nicht mehr. Vielleicht findest du, was du suchst, bei den Projekten oder auf der Startseite.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Zur Startseite</a>
      <a class="btn btn-ghost" href="/projekte">Alle Projekte</a>
    </div>
  </section>
</Base>
