<button
  data-theme-toggle
  type="button"
  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-2 hover:text-ink"
  aria-label="Zwischen hellem und dunklem Design wechseln"
>
  <svg class="nur-dunkel" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="nur-hell" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .nur-hell { display: none; }
  :global(:root[data-theme='light']) .nur-dunkel { display: none; }
  :global(:root[data-theme='light']) .nur-hell { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .nur-dunkel { display: none; }
    :global(:root:not([data-theme='dark'])) .nur-hell { display: block; }
  }
</style>

<script>
  // Steht mehrfach auf einer Seite (eine Kopfzeile je Entwurf), deshalb kein id-Selektor.
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((knopf) =>
    knopf.addEventListener('click', () => {
      const root = document.documentElement;
      const aktuell =
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      const neu = aktuell === 'light' ? 'dark' : 'light';
      root.dataset.theme = neu;
      try {
        localStorage.setItem('theme', neu);
      } catch {}
    }),
  );
</script>
