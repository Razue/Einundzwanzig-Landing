---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HeaderDaily from '../components/HeaderDaily.astro';
import HeaderMagazin from '../components/HeaderMagazin.astro';
import HeaderEntdecken from '../components/HeaderEntdecken.astro';
import Footer from '../components/Footer.astro';
import EntwurfSwitch from '../components/EntwurfSwitch.astro';
import { SITE } from '../lib/site';
import { ENTWUERFE, STANDARD_ENTWURF, type EntwurfId } from '../lib/entwuerfe';
import syneUrl from '@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  // Nur Startseiten setzen das: Sie gehören fest zu einem Entwurf und merken ihn sich als Wahl.
  // Alle anderen Seiten folgen dem zuletzt gewählten Entwurf (Kopfzeile wechselt clientseitig).
  entwurf?: EntwurfId;
}

const { title, description = SITE.description, entwurf } = Astro.props;
const seitentitel = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.claim}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
// Preview-Deployments bauen mit PUBLIC_NOINDEX=1, damit Suchmaschinen sie nicht aufnehmen.
const noindex = import.meta.env.PUBLIC_NOINDEX === '1';
const entwurfListe = ENTWUERFE.map((e) => e.id).join(' ');
---

<!doctype html>
<html
  lang="de"
  data-entwurf={entwurf ?? STANDARD_ENTWURF}
  data-entwurf-fest={entwurf ? '' : undefined}
  data-entwurf-liste={entwurfListe}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={syneUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={monoUrl} />
    <meta name="theme-color" content="#171210" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f0e6" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        var h = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') h.dataset.theme = t;
          if (h.hasAttribute('data-entwurf-fest')) {
            localStorage.setItem('entwurf', h.dataset.entwurf);
          } else {
            var e = localStorage.getItem('entwurf');
            if (e && h.dataset.entwurfListe.split(' ').indexOf(e) >= 0) h.dataset.entwurf = e;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-orange focus:px-4 focus:py-2 focus:text-[#1e1712]"
      >Zum Inhalt springen</a
    >
    <Header />
    <HeaderDaily />
    <HeaderMagazin />
    <HeaderEntdecken />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    {ENTWUERFE.length > 1 && <EntwurfSwitch />}
  </body>
</html>
