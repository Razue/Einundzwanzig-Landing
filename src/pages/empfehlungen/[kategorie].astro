---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RefCard from '../../components/RefCard.astro';
import WerbeHinweis from '../../components/WerbeHinweis.astro';
import { KATEGORIEN } from '../../data/kategorien';

export async function getStaticPaths() {
  const alle = await getCollection('empfehlungen');
  return KATEGORIEN.filter((k) => alle.some((e) => e.data.kategorie === k.slug)).map((k) => ({
    params: { kategorie: k.slug },
    props: { kategorie: k },
  }));
}

const { kategorie } = Astro.props;
const alle = await getCollection('empfehlungen');
const eintraege = alle.filter((e) => e.data.kategorie === kategorie.slug).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const aktiveWerbelinks = alle.filter((e) => e.data.werbelink).length;
---

<Base title={kategorie.titel} description={kategorie.intro}>
  <section class="wrap pt-12 pb-6">
    <a class="text-sm text-ink-3 hover:text-ink" href="/empfehlungen">Alle Empfehlungen</a>
    <h1 class="h1 mt-4 font-display">{kategorie.titel}</h1>
    <p class="mt-5 max-w-[60ch] text-lg text-ink-2">{kategorie.intro}</p>
    <div class="mt-8">
      <WerbeHinweis aktiveWerbelinks={aktiveWerbelinks} />
    </div>
  </section>
  <section class="wrap grid gap-5 pb-14 md:grid-cols-2 xl:grid-cols-3">
    {eintraege.map((e) => <RefCard eintrag={e} />)}
  </section>
</Base>
